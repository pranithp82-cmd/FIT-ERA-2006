// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String?
  role          String         @default("USER") // "USER", "MONITOR", "ADMIN"
  phone         String?
  avatar        String?
  gender        String?
  goal          String?
  age           Int?
  heightCm      Float?
  weightKg      Float?
  location      String?
  bloodType     String?
  status        String         @default("ACTIVE") // "ACTIVE", "INACTIVE"
  trainerSync   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  // Clinical & Telemetry relations
  healthReports HealthReport[]
  dxaReports    DXAReport[]
  foodLogs      FoodLog[]
  workouts      Workout[]
  waterLogs     WaterLog[]
  healthMetrics HealthMetric[]
  conversations AIConversation[]

  // Monitor and RBAC relations
  monitorProfile      MonitorProfile?
  assignedToMonitors  UserMonitorAssignment[]
  monitorNotes        MonitorNote[]
}

model MonitorProfile {
  id              String                  @id @default(uuid())
  userId          String                  @unique
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitorId       String                  @unique // e.g., "ERA-MON-8942"
  specialization  String                  @default("Sports Medicine & Conditioning")
  experienceYears Int                     @default(4)
  status          String                  @default("ACTIVE") // "ACTIVE", "INACTIVE"
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @default(now()) @updatedAt

  assignments     UserMonitorAssignment[]
  notes           MonitorNote[]
}

model UserMonitorAssignment {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitorId   String
  monitor     MonitorProfile @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  assignedAt  DateTime       @default(now())
  status      String         @default("ACTIVE") // "ACTIVE", "PAUSED", "REVOKED"
  notes       String?
  assignedBy  String?        // Admin ID or name
  updatedAt   DateTime       @default(now()) @updatedAt

  @@unique([userId, monitorId])
}

model AssignmentHistory {
  id          String   @id @default(uuid())
  userId      String
  userName    String?
  monitorId   String
  monitorName String?
  action      String   // "ASSIGNED", "REASSIGNED", "REMOVED", "STATUS_CHANGE"
  performedBy String
  details     String?
  timestamp   DateTime @default(now())
}

model MonitorNote {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitorId String
  monitor   MonitorProfile @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  title     String
  content   String
  category  String         @default("GENERAL") // "WORKOUT", "DIET", "GENERAL", "MEDICAL_OBSERVATION"
  isTask    Boolean        @default(false)
  completed Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  actorName    String
  actorRole    String   // "USER", "MONITOR", "ADMIN"
  targetUserId String?
  action       String   // "UPDATE_WORKOUT", "UPDATE_DIET", "ADD_NOTE", "UPDATE_GOAL", "ASSIGN_MONITOR", "STATUS_CHANGE"
  fieldName    String?
  previousValue String?
  newValue     String?
  notes        String?
  timestamp    DateTime @default(now())
}

model AssignedWorkoutPlan {
  id             String   @id @default(uuid())
  userId         String
  title          String
  notes          String?
  exercises      String   // JSON stringified array of exercises, sets, reps, weight
  assignedBy     String?  // Monitor ID / Name
  assignedByName String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model AssignedDietPlan {
  id             String   @id @default(uuid())
  userId         String
  title          String
  targetCalories Float?
  targetProtein  Float?
  targetCarbs    Float?
  targetFat      Float?
  meals          String   // JSON stringified array of meals
  notes          String?
  assignedBy     String?  // Monitor ID / Name
  assignedByName String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model HealthReport {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportDate   DateTime
  uploadDate   DateTime         @default(now())
  laboratory   String?
  packageId    String?
  fileUrl      String?
  
  parameters   BloodParameter[]
}

model BloodParameter {
  id             String       @id @default(uuid())
  reportId       String
  report         HealthReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  testName       String
  value          Float
  unit           String
  referenceLow   Float?
  referenceHigh  Float?
  referenceText  String?
  status         String       // "NORMAL", "LOW", "HIGH", "ATTENTION"
  category       String
  source         String       @default("OCR_EXTRACTED") // "OCR_EXTRACTED", "MANUAL_ENTRY", "VERIFIED"
}

model DXAReport {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportDate   DateTime
  uploadDate   DateTime       @default(now())
  scanTypeId   String?
  fileUrl      String?
  
  parameters   DXAParameter[]
}

model DXAParameter {
  id             String       @id @default(uuid())
  reportId       String
  report         DXAReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  metricName     String       // e.g., "Body Fat", "Lean Mass", "BMD", "T-Score"
  value          Float
  unit           String?
  region         String?      // e.g., "Total", "Arms", "Legs", "Trunk"
}

model Food {
  id          String    @id @default(uuid())
  foodId      String?   @unique
  name        String
  category    String    @default("General")
  servingSize String    @default("100 g/ml")
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  fiber       Float     @default(0)
  sugar       Float     @default(0)
  sodium      Float     @default(0)
  calcium     Float     @default(0)
  iron        Float     @default(0)
  vitaminC    Float     @default(0)
  vitaminA    Float     @default(0)
  vegetarian  Boolean   @default(true)
  vegan       Boolean   @default(false)
  dataType    String    @default("PROTOTYPE_ESTIMATE")
  sourceNote  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  
  foodLogs    FoodLog[]

  @@index([name])
  @@index([category])
  @@index([vegetarian])
  @@index([vegan])
  @@index([foodId])
}

model FoodLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id])
  mealType  String   // "Breakfast", "Lunch", "Dinner", "Snack"
  quantity  Float
  logDate   DateTime @default(now())
}

model Exercise {
  id          String    @id @default(uuid())
  name        String
  category    String    // e.g., "Chest", "Legs"
  
  workouts    WorkoutSet[]
}

model Workout {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  startTime   DateTime     @default(now())
  endTime     DateTime?
  durationMin Int?
  
  sets        WorkoutSet[]
}

model WorkoutSet {
  id          String   @id @default(uuid())
  workoutId   String
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  setNumber   Int
  reps        Int
  weight      Float
  completed   Boolean  @default(false)
}

model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl  Int
  logDate   DateTime @default(now())
}

model HealthMetric {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric    String   // "Weight", "BodyFat"
  value     Float
  date      DateTime @default(now())
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user", "assistant"
  content   String
  timestamp DateTime @default(now())
}
